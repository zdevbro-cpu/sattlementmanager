# ── 서버 ───────────────────────────────
PORT=8787

# ── Cloud SQL(PostgreSQL) 연결 ──────────
# 로컬 개발: 로컬 PostgreSQL, 운영: Cloud SQL 인스턴스 IP
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=sattlementmanager
PGUSER=postgres
PGPASSWORD=
PGSSL=false

# ── Google Drive (파일 저장) ────────────
# 방식 A) OAuth2 사용자 모드 (lavenmanager 패턴)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# 업로드 대상 루트 폴더 ID
GOOGLE_DRIVE_FOLDER_ID=
# 방식 B) 서비스계정 키파일 경로 (contractmanager 패턴, 선택)
GOOGLE_APPLICATION_CREDENTIALS=

# ── Gemini OCR (정보추출) ───────────────
GEMINI_API_KEY=

# ── 일일보고 메일 발송 (SMTP) ───────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

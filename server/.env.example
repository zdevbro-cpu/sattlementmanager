# ── 서버 ───────────────────────────────
PORT=8787

# ── Cloud SQL(PostgreSQL) 연결 ──────────
# 로컬 개발: 로컬 PostgreSQL, 운영: Cloud SQL 인스턴스 IP
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=sattlementmanager
PGUSER=postgres
PGPASSWORD=
PGSSL=false

# ── 운영(Cloud SQL) 연결 정보 — 참고용, 실제 값은 server/.env(gitignore)에만 ──
# GCP 프로젝트: lassettlemanager
# 인스턴스: sattlementmanager-db (PostgreSQL 15, db-f1-micro, asia-northeast3)
# 연결명: lassettlemanager:asia-northeast3:sattlementmanager-db
# 공인 IP: 34.47.116.176 (인가된 네트워크에 개발 PC IP 등록 필요)
# PGHOST=34.47.116.176
# PGDATABASE=postgres
# PGUSER=postgres
# PGSSL=false

# ── Google Drive (파일 저장) ────────────
# 방식 A) OAuth2 사용자 모드
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# 업로드 대상 루트 폴더 ID
GOOGLE_DRIVE_FOLDER_ID=
# 방식 B) 서비스계정 키파일 경로 (contractmanager 패턴, 선택)
GOOGLE_APPLICATION_CREDENTIALS=

# ── Gemini OCR (정보추출) ───────────────
GEMINI_API_KEY=

# ── 일일보고 메일 발송 ───────────────────
# 방식 A) Gmail 앱 비밀번호 (우선 사용)
GMAIL_USER=zdevbro@gmail.com
GMAIL_APP_PASSWORD=
# 방식 B) 범용 SMTP (GMAIL_APP_PASSWORD 미설정 시 폴백)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── 자동 일일보고 cron 인증 ──────────────
# Cloud Scheduler → POST /api/cron/daily-sales-report 호출 시 x-cron-secret 헤더로 검증
CRON_SECRET=
